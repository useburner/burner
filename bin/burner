def _setup_step_status(step):
    """Return 'done', 'pending', or 'unknown' for a step."""
    try:
        live = step["check"]()
    except Exception:
        live = None
    if live is True:
        return "done"
    if live is False:
        return "pending"
    st = _setup_state_load()
    if step["name"] in st["done"]:
        return "done"
    return "unknown"


def _setup_print_human(step):
    print("HUMAN STEP: {}".format(step["title"]))
    print(step["instruction"])
    print("When done, tell the agent; it records with: "
          "burner setup --step {} --confirm".format(step["name"]))


def _setup_ask(prompt, auto_yes):
    if auto_yes:
        return True
    try:
        ans = input(prompt + " [y/n] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return ans in ("y", "yes")


def cmd_setup(args):
    steps = {s["name"]: s for s in SETUP_STEPS}

    if args.list_steps:
        for s in SETUP_STEPS:
            print("{:24s} {:6s} {}".format(
                s["name"], s["kind"], _setup_step_status(s)))
        return 0

    if args.step:
        s = steps.get(args.step)
        if not s:
            print("unknown step: {}. Use --list-steps.".format(args.step),
                  file=sys.stderr)
            return 1
        if args.confirm:
            _setup_state_save(s["name"])
            print("recorded '{}' as done.".format(s["name"]))
            return 0
        status = _setup_step_status(s)
        if status == "done":
            print("step '{}' already done.".format(s["name"]))
            return 0
        if s["kind"] == "human":
            _setup_print_human(s)
            return 0
        rc = s["run"](args)
        if rc == 0 and _setup_step_status(s) == "done":
            _setup_state_save(s["name"])
        return rc

    # Full interactive run.
    for s in SETUP_STEPS:
        status = _setup_step_status(s)
        print("--- {} [{}]".format(s["name"], status))
        if status == "done":
            continue
        if s["kind"] == "human":
            _setup_print_human(s)
            if args.yes:
                print("(waiting on the human; continuing to agent steps)")
                continue
            try:
                ans = input("done, skip, or quit? [done/skip/quit] "
                            ).strip().lower()
            except (EOFError, KeyboardInterrupt):
                print()
                return 1
            if ans == "done":
                _setup_state_save(s["name"])
            elif ans == "quit":
                return 1
            continue
        if not _setup_ask("run '{}'?".format(s["title"]), args.yes):
            print("skipped.")
            continue
        rc = s["run"](args)
        if rc != 0:
            print("step '{}' failed; fix it and re-run.".format(s["name"]),
                  file=sys.stderr)
            return rc
        if _setup_step_status(s) == "done":
            _setup_state_save(s["name"])
    print("setup complete.")
    return 0


INSTALL_URL = "https://useburner.si/install.sh"
BRANCH_INSTALL_URL = "https://raw.githubusercontent.com/useburner/burner/{ref}/docs/install.sh"


TARBALL_URL = "https://github.com/useburner/burner/archive/refs/heads/{ref}.tar.gz"
FAST_SKILL = "SKILL-fast.md"


REF_OK = re.compile(r"[A-Za-z0-9._/-]+")


def install_ref():
    """Branch this install came from: .burner-ref (written by the web
    installer), else a git checkout's branch, else master."""
    try:
        with open(os.path.join(ROOT, ".burner-ref")) as f:
            ref = f.read().strip()
        if REF_OK.fullmatch(ref):
            return ref
    except OSError:
        pass
    if os.path.isdir(os.path.join(ROOT, ".git")):
        try:
            r = subprocess.run(["git", "-C", ROOT, "rev-parse", "--abbrev-ref", "HEAD"],
                               capture_output=True, text=True, timeout=5)
            name = (r.stdout or "").strip()
            if r.returncode == 0 and name != "HEAD" and REF_OK.fullmatch(name):
                return name
        except Exception:
            pass
    return "master"


def skill_path():
    """The guide to re-read after an update: the fast guide on a branch
    that ships one, else SKILL.md."""
    fast = os.path.join(ROOT, FAST_SKILL)
    if install_ref() != "master" and os.path.exists(fast):
        return fast
    return os.path.join(ROOT, "SKILL.md")


def _update_recipes():
    """Refresh only the built-in recipes from the latest burner release.
    Recipes you recorded under your own names are left alone."""
    import io
    import tarfile
    try:
        blob = _setup_urlopen(TARBALL_URL.format(ref=install_ref()), timeout=120)
    except Exception as e:
        print("could not download the latest recipes: {}".format(e),
              file=sys.stderr)
        return 1
    dest = os.path.join(ROOT, "recipes")
    os.makedirs(dest, exist_ok=True)
    names = []
    with tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz") as tf:
        for m in tf.getmembers():
            parts = m.name.split("/")
            if (m.isfile() and len(parts) == 3 and parts[1] == "recipes"
                    and parts[2].endswith(".burner")):
                with open(os.path.join(dest, parts[2]), "wb") as f:
                    f.write(tf.extractfile(m).read())
                names.append(parts[2][:-len(".burner")])
    if not names:
        print("no recipes found in the latest release.", file=sys.stderr)
        return 1
    print("recipes updated: {}".format(", ".join(sorted(names))))
    return 0


def skill_rev(text):
    """Short content hash of SKILL.md. tools/sync_skill.py prints the same
    hash in the header of useburner.si/skill.md, so an assistant can tell
    whether its installed copy matches the site's."""
    import hashlib
    return hashlib.sha256(
        text.replace("\r\n", "\n").encode("utf-8")).hexdigest()[:8]


def build_commit():
    """Commit this install came from: .burner-version (written by the web
    installer from the release tarball), else the git checkout's HEAD."""
    try:
        with open(os.path.join(ROOT, ".burner-version")) as f:
            sha = f.read().strip()
        if sha:
            return sha
    except OSError:
        pass
    try:
        r = subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def cmd_version(args):
    sha = build_commit()
    try:
        with open(os.path.join(ROOT, "SKILL.md"), encoding="utf-8") as f:
            rev = skill_rev(f.read())
    except OSError:
        rev = None
    ref = install_ref()
    if as_json(args):
        print(json.dumps({"ok": True, "commit": sha, "skill_rev": rev, "ref": ref}))
        return 0
    branch = "" if ref == "master" else " on branch " + ref
    print("burner {}{} (skill rev {})".format(
        sha[:7] if sha else "unknown", branch, rev or "unknown"))
    return 0


def cmd_update(args):
    """Re-run the web installer over this install. Keeps config.env, the
    phone pairing and your own recorded recipes; built-in recipes and burner
    itself are refreshed. `burner update recipes` refreshes only recipes."""
    if getattr(args, "what", None) == "recipes":
        return _update_recipes()
    ref = install_ref()
    env = dict(os.environ, BURNER_DIR=ROOT, BURNER_REF=ref)
    url = INSTALL_URL if ref == "master" else BRANCH_INSTALL_URL.format(ref=ref)
    # pipefail: a failed download (offline, or a branch that is gone) must
    # not feed bash an empty script and report success.
    r = subprocess.run(["bash", "-c", 'set -o pipefail; curl -fsSL "$1" | bash',
                        "burner-update", url], env=env)
    if r.returncode != 0:
        print("update failed (see above). Nothing was changed if the download "
              "failed; the branch is {}.".format(ref), file=sys.stderr)
        return r.returncode
    _stop_helper_daemons()
    # Start both helpers again now, and wait for the UI helper: the first
    # command after an update used to pay the 10-15s restart (Muse's
    # `start` took 13.6s on Oct 4). update is where that wait belongs.
    u2_start_background()
    try:
        subprocess.Popen([sys.executable, os.path.join(SCRCPY_DIR, "scrcpy_ctl.py"),
                          "ping"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass
    if wait_for_helper(30):
        print("helpers restarted.")
    else:
        print("the UI helper is still starting; the next command may take "
              "a few seconds longer.")
    print("Updated. Re-read {} now: the instructions may have changed.".format(
        skill_path()))
    return 0


def wait_for_helper(timeout):
    """True once the UI helper answers, or False after timeout seconds."""
    t0 = time.time()
    while time.time() - t0 < timeout:
        if os.path.exists(U2_SOCK) and u2sock("health", timeout=10) is not None:
            return True
        time.sleep(0.5)
    return False


def _stop_helper_daemons():
    """Stop the long-running helpers (scrcpy mux, u2 mux) so the next command
    starts them from the freshly updated code. Without this they keep
    running the old code until killed by hand."""
    import signal
    for name in ("scrcpy-mux", "u2-mux"):
        pidfile = os.path.join(ROOT, "run", name + ".pid")
        try:
            with open(pidfile) as f:
                os.kill(int(f.read().strip()), signal.SIGTERM)
        except (OSError, ValueError):
            pass  # not running
        for ext in (".pid", ".sock"):
            try:
                os.remove(os.path.join(ROOT, "run", name + ext))
            except OSError:
                pass


UNINSTALL_STEPS = [
    ("screen no longer stays on while charging",
     ["settings", "put", "global", "stay_on_while_plugged_in", "0"]),
    ("swipe lock screen back on",
     ["locksettings", "set-disabled", "false"]),
    ("Tailscale no longer set as always-on VPN",
     ["settings", "delete", "secure", "always_on_vpn_app"]),
    ("ADB Auto Enable removed", ["pm", "uninstall", SETUP_APK_PKG]),
    ("uiautomator helper app removed",
     ["pm", "uninstall", "com.github.uiautomator"]),
    ("uiautomator test app removed",
     ["pm", "uninstall", "com.github.uiautomator.test"]),
    ("uiautomator server file removed",
     ["rm", "-f", "/data/local/tmp/u2.jar"]),
    # Last: this drops our own connection to the phone.
    ("Wireless debugging turned off",
     ["settings", "put", "global", "adb_wifi_enabled", "0"]),
]


def cmd_uninstall(args):
    """Undo what burner setup changed on the phone, then forget setup state.
    Leaves Tailscale, Developer options and this computer's files alone."""
    if not args.yes:
        print("burner uninstall will, on the phone:")
        for label, _ in UNINSTALL_STEPS:
            print("  - {}".format(label))
        print("and forget this computer's setup progress. Tailscale and "
              "Developer options stay as they are. Run with --yes to do it.")
        return 0
    if _setup_device_state() != "device":
        print("phone not reachable; run `burner ensure` first.", file=sys.stderr)
        return 1
    for label, cmd in UNINSTALL_STEPS:
        try:
            r = adb("shell", *cmd, timeout=30)
            ok = r.returncode == 0
        except Exception:
            ok = cmd[-1] == "0"  # the connection drop on the last step
        print("{} {}".format("ok  " if ok else "skip", label))
    adb("disconnect", TARGET, timeout=10)
    try:
        os.remove(SETUP_STATE_PATH)
    except OSError:
        pass
    print("done. To remove burner from this computer too, delete {}".format(ROOT))
    return 0


LOCKED_COMMANDS = {"tap", "type", "press", "scroll", "start", "open", "do",
                   "recipe", "replay", "dismiss", "notifications", "settings"}


def _acquire_lock(path=None, timeout=120):
    """Run one screen-changing burner command at a time per phone.

    Assistants sometimes fire several burner commands at once (two taps, or a
    tap and a swipe in parallel). They fight over the screen. Queue them
    instead. Returns the held lock file, or None when locking isn't
    available (Windows) or another burner command held it for `timeout`
    seconds (then we run anyway rather than hang). Child burner processes
    inherit BURNER_LOCK_HELD and skip the lock, so recipes can't deadlock."""
    if os.environ.get("BURNER_LOCK_HELD"):
        return None
    try:
        import fcntl
    except ImportError:
        return None
    path = path or os.path.join(ROOT, "run", "burner.lock")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        f = open(path, "w")
    except OSError:
        return None
    deadline = time.time() + timeout
    told = False
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.environ["BURNER_LOCK_HELD"] = "1"
            return f
        except OSError:
            if time.time() >= deadline:
                f.close()
                return None
            if not told:
                print("waiting for another burner command to finish...",
                      file=sys.stderr)
                told = True
            time.sleep(0.2)


# Commands that legitimately run long or set their own time limit.
WATCHDOG_EXEMPT = {"setup", "update", "do", "recipe", "replay", "wait", "vcode",
                   "gcode", "record", "sleep", "amazon-status", "uninstall",
                   "doctor", "ensure"}


def _arm_watchdog(args):
    """Fail a stuck command instead of hanging forever: after BURNER_TIMEOUT
    seconds (default 60) print what happened and exit 124."""
    import signal
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        limit = int(os.environ.get("BURNER_TIMEOUT", "60"))
    except ValueError:
        limit = 60
    if cmd in WATCHDOG_EXEMPT or limit <= 0 or not hasattr(signal, "SIGALRM"):
        return

    def fire(signum, frame):
        print("burner {}: no result after {}s, stopped. The phone may be "
              "asleep or unreachable: run `burner ensure`, then try again."
              .format(cmd, limit), file=sys.stderr)
        log_command((time.time() - _T0) * 1000, 124)
        os._exit(124)
    signal.signal(signal.SIGALRM, fire)
    signal.alarm(limit)


COMMANDS_LOG = os.path.join(ROOT, "run", "commands.log")
COMMANDS_LOG_MAX = 400 * 1024  # bytes: trimmed to the newest half past this


_LOG_KEEP_VALUE = {"--field", "--clear-keys", "--timeout"}
_LOG_GLOBAL_OPTS = {"--json"}  # burner's own options, before the command


def _mask_type(words):
    """`type`'s arguments with the typed text masked: a flag stays, and so
    does the value of a flag that takes one; whatever else is there is
    the typed text (past a bare --, everything is)."""
    masked, after_dashes = [], False
    for prev, w in zip([""] + words, words):
        if after_dashes:
            masked.append("…")
            continue
        if w == "--":
            after_dashes = True
            masked.append(w)
            continue
        keep = (w.startswith("-") and len(w) > 1) or prev in _LOG_KEEP_VALUE
        masked.append(w if keep else "…")
    return masked


def _mask_flow(flow):
    """A do/save/record/replay argument with the text of every `type` step
    in it masked, the step's flags and their values kept (a pattern that
    masked the first word after `type` kept the text after a --field,
    found in review Oct 5)."""
    steps = []
    for step in flow.split(";"):
        try:
            ws = shlex.split(step)
        except ValueError:
            ws = step.split()
        if ws and ws[0] == "type":
            step = " ".join(["type"] + [w if w == "…" else shlex.quote(w) for w in _mask_type(ws[1:])])
        steps.append(step.strip())
    return "; ".join(steps)


def log_line(argv, ms, rc):
    """One line for run/commands.log: when, how long, the exit code and the
    command. Typed text never goes in: every `type` argument but its flags
    is masked (behind burner's own options too), `type` steps inside a
    `do`/`save` flow lose their text, and a pairing code stays out."""
    words = list(argv)
    lead = 0
    while lead < len(words) and words[lead] in _LOG_GLOBAL_OPTS:
        lead += 1
    cmd = words[lead] if lead < len(words) else ""
    if cmd == "type":
        words = words[:lead + 1] + _mask_type(words[lead + 1:])
    elif cmd in ("do", "save", "record", "replay"):
        words = words[:lead + 1] + [_mask_flow(w) for w in words[lead + 1:]]
    elif cmd == "setup":
        for i, w in enumerate(words):
            if i and words[i - 1] == "--code":
                words[i] = "…"
    return "{} {:>6}ms exit {} burner {}".format(
        time.strftime("%Y-%m-%d %H:%M:%S"), int(ms), rc,
        " ".join(shlex.quote(w) for w in words))


def log_command(ms, rc):
    """Append this command to run/commands.log. Never raises."""
    try:
        os.makedirs(os.path.dirname(COMMANDS_LOG), exist_ok=True)
        try:
            big = os.path.getsize(COMMANDS_LOG) > COMMANDS_LOG_MAX
        except OSError:
            big = False
        if big:
            with open(COMMANDS_LOG, encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
            with open(COMMANDS_LOG, "w", encoding="utf-8") as f:
                f.writelines(lines[len(lines) // 2:])
        # Only this user reads it (0600): it lists what was done on the phone.
        fd = os.open(COMMANDS_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as f:
            f.write(log_line(sys.argv[1:], ms, rc) + "\n")
    except Exception:
        pass


def cmd_log(args):
    """Print the last commands run, with how long each took and how it
    ended: where the time went in a task, without any other tool."""
    try:
        with open(COMMANDS_LOG, encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        print("no commands logged yet")
        return 0
    sys.stdout.writelines(lines[-max(1, args.last):])
    return 0


def main():
    ap = build_parser()
    args = ap.parse_args()
    # Session recording: log action commands to the active recipe file.
    # This happens before execution so the command is captured even if it fails.
    # (The record/replay commands themselves are not recorded.)
    cmd_line = record_command_line(args)
    if cmd_line:
        record_log(cmd_line)
    # Only commands that change the screen queue; reads (dump, shot, wait)
    # stay free, so a `wait` can't hold back the tap it is waiting for.
    _lock = (_acquire_lock() if sys.argv[1:2] and sys.argv[1] in
             LOCKED_COMMANDS else None)  # noqa: F841 (held until exit)
    _arm_watchdog(args)
    if os.environ.get("BURNER_TRACE"):
        import atexit
        atexit.register(_trace_total)
        _trace_sleeps()
        _trace_json("start", None)  # touch the file: the UI helper traces too
    rc = 1
    try:
        rc = args.fn(args) or 0
    except _ADB_TIMEOUT:
        # A phone that is asleep or off the tailnet makes adb hang. Say so
        # plainly instead of dumping a traceback.
        print("burner: the phone didn't answer in time. Check that it's on "
              "the charger with the screen awake and that Tailscale is "
              "connected, then run `burner doctor`.", file=sys.stderr)
    except RuntimeError as e:
        if "kept coming back empty" not in str(e):
            raise
        print("burner: couldn't read the phone's screen. Check that it's on "
              "the charger with the screen awake and that Tailscale is "
              "connected, then run `burner ensure`.", file=sys.stderr)
    except SystemExit as e:
        # A command that exits by itself: same code (a message prints and
        # exits 1, as Python does), but logged first.
        if e.code is None:
            rc = 0
        elif isinstance(e.code, int):
            rc = e.code
        else:
            print(e.code, file=sys.stderr)
    finally:
        # Every command ends up in the log, a crash included (rc stays 1).
        if getattr(args, "cmd", None) != "log":
            log_command((time.time() - _T0) * 1000, rc)
    sys.exit(rc)


if __name__ == "__main__":
    main()

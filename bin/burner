    p.set_defaults(fn=cmd_forget)

    p = sub.add_parser("setup", help="guided phone setup wizard")
    p.add_argument("--list-steps", action="store_true",
                   help="list setup steps with their status")
    p.add_argument("--step", metavar="NAME",
                   help="run a single step non-interactively")
    p.add_argument("--confirm", action="store_true",
                   help="record a human step as done (with --step)")
    p.add_argument("--yes", action="store_true",
                   help="auto-confirm agent actions")
    p.add_argument("--code", metavar="CODE",
                   help="6-digit pairing code (pair step; never stored)")
    p.add_argument("--ip", metavar="IP",
                   help="phone tailnet IP from pairing dialog (pair step)")
    p.add_argument("--pair-port", metavar="PORT",
                   help="pairing port from pairing dialog (pair step)")
    p.add_argument("--connect-port", metavar="PORT",
                   help="wireless debugging port (pair step)")
    p.set_defaults(fn=cmd_setup)

    p = sub.add_parser("update", help="update burner and its recipes to the latest")
    p.add_argument("what", nargs="?", choices=["recipes"],
                   help="'recipes' to refresh only the built-in recipes")
    p.set_defaults(fn=cmd_update)

    p = sub.add_parser("log", help="the last commands run, with their times and exit codes")
    p.add_argument("--last", type=int, default=40, help="how many lines (default 40)")
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("uninstall", help="undo the phone changes burner setup made")
    p.add_argument("--yes", action="store_true",
                   help="actually do it (without it, only list the changes)")
    p.set_defaults(fn=cmd_uninstall)

    return ap


def cmd_do(args):
    ap = build_parser()
    steps = [s.strip() for s in args.flow.split(";") if s.strip()]
    for i, step in enumerate(steps, 1):
        try:
            ns = ap.parse_args(shlex.split(step))
        except SystemExit:
            print("do: bad step {}: {}".format(i, step), file=sys.stderr)
            return 1
        if i < len(steps) and hasattr(ns, "quiet"):
            ns.quiet = True  # only the last step prints the screen
        print("do [{}]: {}".format(i, step), flush=True)
        rc = ns.fn(ns)
        if rc == WAIT_STILL_RC:
            # a long wait's slice ended, or the phone asked the user
            # something: the flow pauses here, and goes on from this step
            # once the assistant has told (or asked) the user
            rest = "; ".join(steps[i - 1:])
            print("do: paused at step {} (still waiting). Tell the user, then go on with: burner do {}"
                  .format(i, shlex.quote(rest)))
            return rc
        if rc:
            print("do: step {} failed, stopping".format(i), file=sys.stderr)
            return rc
        if i < len(steps):
            asked = _asked_now()
            if asked:
                # a system dialog asks the user something (a permission, an
                # install): the steps after this one wait for their answer
                print('do: paused after step {}: the phone asks: {} | options: {}. Ask the user, tap '
                      'their answer, then go on with: burner do {}'.format(
                          i, asked["text"], " / ".join(asked["options"]), shlex.quote("; ".join(steps[i:]))))
                return WAIT_STILL_RC
    return 0


def cmd_recipe(args):
    path = os.path.join(ROOT, "recipes", args.name + ".burner")
    if not os.path.exists(path):
        print("no recipe: {}".format(path), file=sys.stderr)
        return 1
    # $VAR / ${VAR} in steps expand from the environment, so one recipe can
    # take parameters: PLAY_PACKAGE=com.example.app burner recipe play-install
    steps = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                line = os.path.expandvars(line)
                unset = re.search(r"\$\{?([A-Za-z_]\w*)", line)
                if unset:
                    print("recipe {}: ${} is not set".format(args.name, unset.group(1)),
                          file=sys.stderr)
                    return 1
                steps.append(line)
    return cmd_do(argparse.Namespace(flow="; ".join(steps)))


def cmd_recipes(args):
    """List recipes with the first comment line of each."""
    d = os.path.join(ROOT, "recipes")
    names = sorted(f[:-len(".burner")] for f in os.listdir(d)
                   if f.endswith(".burner")) if os.path.isdir(d) else []
    for n in names:
        desc = ""
        try:
            with open(os.path.join(d, n + ".burner"), encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("#") and len(line) > 1:
                        desc = line.lstrip("#").strip()
                        break
        except OSError:
            pass
        print("{:24s} {}".format(n, desc))
    return 0


SAVE_VERBS = {"tap", "type", "press", "wait", "start", "open", "scroll",
              "shot", "state", "dump", "snap", "dismiss", "sleep", "apps", "settings"}


def check_save_steps(steps, allow_text=False):
    """Return an error message for the first bad step, or None. Pure apart
    from building the parser, so it is unit-testable."""
    ap = build_parser()
    for i, step in enumerate(steps, 1):
        try:
            words = shlex.split(step)
        except ValueError:
            return "step {} has unbalanced quotes: {}".format(i, step)
        if not words or words[0] not in SAVE_VERBS:
            return "step {} must start with one of: {} (got: {})".format(
                i, ", ".join(sorted(SAVE_VERBS)), step)
        if re.search(r"(^|\s)@e\d+", step):
            return ("step {} uses a snap handle (@eN). Handles last for one "
                    "screen only; use the label instead, e.g. tap \"Orders\"."
                    .format(i))
        if words[0] == "type" and not allow_text \
                and not re.search(r"\$\{?[A-Za-z_]", step):
            return ("step {} types fixed text. Use a $VARIABLE (like type "
                    "\"$QUERY\") so personal text isn't saved in the recipe, "
                    "or pass --allow-text.".format(i))
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                ap.parse_args(words)
        except SystemExit:
            return "step {} isn't a valid burner command: {}".format(i, step)
    return None


def cmd_save(args):
    """Save a repeatable task as recipes/<name>.burner, so it can be run
    again with `burner recipe <name>`. Steps are checked first, so a typo
    doesn't turn into a recipe that fails halfway through."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", args.name or ""):
        print("save: name must be lowercase letters, digits, - and _",
              file=sys.stderr)
        return 1
    steps = [s.strip() for s in args.steps if s.strip()]
    if not steps and not sys.stdin.isatty():
        steps = [l.strip() for l in sys.stdin.read().splitlines()
                 if l.strip() and not l.strip().startswith("#")]
    if not steps:
        print("save: no steps. Pass one step per argument, or on stdin.",
              file=sys.stderr)
        return 1
    err = check_save_steps(steps, args.allow_text)
    if err:
        print("save: " + err, file=sys.stderr)
        return 1
    path = os.path.join(ROOT, "recipes", args.name + ".burner")
    if os.path.exists(path) and not args.force:
        print("save: recipe '{}' exists (use --force to overwrite)".format(
            args.name), file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write("# {}\n".format(args.desc.strip() or "Saved recipe: " + args.name))
        f.write("# Run: burner recipe {}\n".format(args.name))
        for step in steps:
            f.write(step + "\n")
    print("saved {} ({} steps). Run it with: burner recipe {}".format(
        path, len(steps), args.name))
    return 0


# ------------------------------------------------------- record / replay
"""
Session recording: `burner record <name>` captures every action command to
recipes/<name>.burner, which can be replayed with `burner replay <name>`.

Recording captures the actual commands issued (tap, press, type, wait, start,
open), not just outcomes. The recipe file is a plain text list of burner
subcommands, human-readable and editable.
"""

RECORD_STATE = os.path.join(os.path.expanduser("~"), ".cache", "burner", "recording.json")


def record_active():
    """Check if recording is active. Returns (name, path) or (None, None)."""
    try:
        if os.path.exists(RECORD_STATE):
            with open(RECORD_STATE) as f:
                st = json.load(f)
                return st.get("name"), st.get("path")
    except Exception:
        pass
    return None, None


def record_log(command_line):
    """Append a command to the active recording, if any. Never raises."""
    try:
        name, path = record_active()
        if not name or not path:
            return
        # Don't record the record command itself, or non-action commands
        # that would pollute the recipe (dump, snap, doctor, etc.)
        with open(path, "a") as f:
            f.write(command_line + "\n")
    except Exception:
        pass


def record_command_line(args):
    """Reconstruct the burner subcommand line from parsed args for recording.
    Returns the command string (without 'burner' prefix), or None if not recordable."""
    # Map of command -> how to reconstruct
    # We use sys.argv to get the original, stripping the 'burner' prefix
    try:
        argv = sys.argv[1:]  # skip 'burner'
        if not argv:
            return None
        # Skip non-action commands
        non_recordable = {"dump", "snap", "doctor", "state", "shot", "whereami",
                          "route", "forget", "record", "replay", "recipe", "do",
                          "ensure", "gcode", "vcode", "amazon-status", "setup",
                          "uninstall", "update", "apps", "status", "dismiss", "notifications",
                          "recipes", "save", "log"}
        if argv[0] in non_recordable:
            return None
        # Reconstruct with proper quoting
        return " ".join(shlex.quote(a) for a in argv)
    except Exception:
        return None


def cmd_record(args):
    """Start or stop recording a session to recipes/<name>.burner."""
    if args.stop:
        name, path = record_active()
        if not name:
            print("not recording")
            return 0
        try:
            os.remove(RECORD_STATE)
        except OSError:
            pass
        print("stopped recording '{}' -> {}".format(name, path))
        return 0
    # Start recording
    name = args.name
    if not name:
        print("usage: burner record <name> | burner record --stop", file=sys.stderr)
        return 1
    # Check if already recording
    active_name, _ = record_active()
    if active_name:
        print("already recording '{}' (stop with `burner record --stop`)".format(active_name),
              file=sys.stderr)
        return 1
    path = os.path.join(ROOT, "recipes", name + ".burner")
    # Don't overwrite existing without --force
    if os.path.exists(path) and not args.force:
        print("recipe '{}' exists (use --force to overwrite)".format(name),
              file=sys.stderr)
        return 1
    # Initialize the file with a header
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("# Recorded session: {}\n".format(name))
        f.write("# Started: {}\n".format(time.strftime("%Y-%m-%d %H:%M:%S")))
    # Save recording state
    os.makedirs(os.path.dirname(RECORD_STATE), exist_ok=True)
    with open(RECORD_STATE, "w") as f:
        json.dump({"name": name, "path": path, "started": time.time()}, f)
    print("recording to '{}' (stop with `burner record --stop`)".format(path))
    return 0


def cmd_replay(args):
    """Replay a recorded session. Same as `burner recipe`, but with step-by-step output."""
    path = os.path.join(ROOT, "recipes", args.name + ".burner")
    if not os.path.exists(path):
        print("no recording: {}".format(path), file=sys.stderr)
        return 1
    steps = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                steps.append(line)
    print("replaying '{}' ({} steps)".format(args.name, len(steps)))
    return cmd_do(argparse.Namespace(flow="; ".join(steps)))


# ------------------------------------------------------- setup wizard
"""
Guided phone setup: `burner setup` walks a human + agent through pairing a new
burner phone, step by step. Human steps print an instruction and a screenshot
path; the agent relays them in chat and records completion with
`burner setup --step <name> --confirm`. Agent steps run automatically.
Pairing codes are transient: passed on stdin to `adb pair`, never stored.
"""

SETUP_STATE_PATH = os.path.join(os.path.expanduser("~"), ".cache", "burner",
                                "setup-state.json")
SETUP_APK_CACHE = os.path.join(os.path.expanduser("~"), ".cache", "burner")
SETUP_APK_VERSION = "v0.3.5"
SETUP_APK_PKG = "com.tpn.adbautoenable"
SETUP_VPN_APP = "com.tailscale.ipn"
# Full URLs so chat apps can show them; the files also live in setup/.
SETUP_SHOTS = "https://useburner.si/setup/setup-{:02d}-{}.png"


def _setup_sh(*args, timeout=15):
    """Run an adb shell command, return stripped stdout or None on failure."""
    try:
        r = adb("shell", *args, timeout=timeout)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return (r.stdout or "").strip() or None


def _setup_get_setting(namespace, key):
    v = _setup_sh("settings", "get", namespace, key)
    return v if v not in (None, "null") else None


def _setup_device_state():
    try:
        r = adb("get-state", timeout=10)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return (r.stdout or "").strip() or None


def _setup_state_load():
    try:
        with open(SETUP_STATE_PATH) as f:
            st = json.load(f)
            if isinstance(st.get("done"), dict):
                return st
    except Exception:
        pass
    return {"done": {}}


def _setup_state_save(step):
    st = _setup_state_load()
    st["done"][step] = time.strftime("%Y-%m-%dT%H:%M:%S")
    try:
        os.makedirs(os.path.dirname(SETUP_STATE_PATH), exist_ok=True)
        with open(SETUP_STATE_PATH, "w") as f:
            json.dump(st, f, indent=2)
    except OSError as e:
        print("warning: could not save setup state: {}".format(e),
              file=sys.stderr)


def _setup_write_config(updates):
    """Update keys in config.env, preserving comments and other lines."""
    path = os.path.join(ROOT, "config.env")
    lines = []
    if os.path.exists(path):
        with open(path) as f:
            lines = f.readlines()
    seen = set()
    out = []
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and "=" in s:
            k = s.split("=", 1)[0].strip()
            if k in updates:
                out.append('{}="{}"\n'.format(k, updates[k]))
                seen.add(k)
                continue
        out.append(line)
    for k, v in updates.items():
        if k not in seen:
            out.append('{}="{}"\n'.format(k, v))
    with open(path, "w") as f:
        f.writelines(out)
    global CFG, TARGET
    CFG = load_config()
    TARGET = "127.0.0.1:{}".format(CFG.get("LOCAL_PORT", "15555"))


def _setup_spawn(cmd, input_text=None, timeout=60):
    """Run a subprocess (socat, adb pair). Separate helper so tests can mock."""
    return subprocess.run(cmd, input=input_text, capture_output=True,
                          text=True, timeout=timeout)


def _setup_popen(cmd):
    """Start a background subprocess (tunnel). Separate helper for tests."""
    return subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)


def _setup_urlopen(url, timeout=60):
    """Fetch a URL, return bytes. Separate helper so tests can mock."""
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": "burner-setup"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


# --- step check functions: True=done, False=not done, None=cannot tell ---

def _check_prereqs():
    try:
        r = _setup_spawn([ADB_BIN, "version"], timeout=10)
    except Exception:
        return False
    return r.returncode == 0


def parse_plain_tailscale_status(text):
    """Status dict from plain `tailscale status` text, for hosts whose
    tailscale command has no --json (hosted assistants). Only says whether
    this computer is on the tailnet. Pure function."""
    t = (text or "").lower()
    if not t.strip():
        return None
    bad = ("not connected", "disconnected", "stopped", "logged out",
           "needs login", "needs machine auth", "no state")
    if any(b in t for b in bad):
        return {"BackendState": "Stopped"}
    if "connected" in t or "running" in t:
        return {"BackendState": "Running"}
    return None


def _setup_tailscale_status():
    try:
        r = _setup_spawn(["tailscale", "status", "--json"], timeout=15)
        return json.loads(r.stdout or "{}")
    except Exception:
        pass
    try:  # some hosts' tailscale has no --json: read the plain text
        r = _setup_spawn(["tailscale", "status"], timeout=15)
        if r.returncode == 0:
            return parse_plain_tailscale_status(r.stdout)
    except Exception:
        pass
    return None


def _check_tailnet():
    if _setup_device_state() == "device":
        return True  # the phone answers, however this computer gets there
    st = _setup_tailscale_status()
    if st is None:
        return None  # no Tailscale here (same-LAN setup) or can't tell
    return st.get("BackendState") == "Running"


def _run_tailnet(args):
    """Join this computer to the user's tailnet, surfacing the approval link."""
    if _check_tailnet():
        print("this computer is on your tailnet.")
        return 0
    if _setup_device_state() == "device":
        # Hosted assistants reach the phone through their host's tunnel
        # instead of a Tailscale client of their own: nothing to approve.
        print("this computer already reaches the phone; nothing to approve.")
        return 0
    if _setup_tailscale_status() is None:
        print("Tailscale isn't installed here. Install it, or put this "
              "computer on the same Wi-Fi as the phone.", file=sys.stderr)
        return 1
    _setup_popen(["tailscale", "up"])
    url = None
    for _ in range(20):
        st = _setup_tailscale_status() or {}
        if st.get("BackendState") == "Running":
            print("this computer is on your tailnet.")
            return 0
        url = st.get("AuthURL")
        if url:
            break
        time.sleep(1)
    if not url:
        print("Tailscale didn't give an approval link. Run `tailscale up` "
              "and send the user the link it prints.", file=sys.stderr)
        return 1
    print("APPROVAL NEEDED. Send the user this link as its own message, ask "
          "them to open it and approve this computer, then re-run this "
          "step: {}".format(url))
    return 1


def _setup_tailnet_android_online():
    """True if this machine's tailnet shows an Android device online."""
    try:
        r = _setup_spawn(["tailscale", "status", "--json"], timeout=15)
        peers = json.loads(r.stdout or "{}").get("Peer") or {}
    except Exception:
        return None
    return any((p.get("OS") or "").lower() == "android" and p.get("Online")
               for p in peers.values())


def _check_tailscale_phone():
    # The phone is reachable over adb only via Tailscale (or LAN).
    st = _setup_device_state()
    if st == "device":
        return True
    # Before pairing: if the tailnet already shows an Android phone online,
    # Tailscale is done on it and the user can skip this step.
    if _setup_tailnet_android_online():
        return True
    return None


def _check_tailscale_battery():
    out = _setup_sh("dumpsys", "deviceidle", "whitelist")
    if out is None:
        return None
    return SETUP_VPN_APP in out


def _run_tailscale_battery(args):
    # Same as Settings > Apps > Tailscale > App battery usage > Unrestricted.
    adb("shell", "dumpsys", "deviceidle", "whitelist", "+" + SETUP_VPN_APP,
        timeout=15)
    adb("shell", "cmd", "appops", "set", SETUP_VPN_APP,
        "RUN_ANY_IN_BACKGROUND", "allow", timeout=15)
    if not _check_tailscale_battery():
        print("could not set Tailscale battery usage to Unrestricted.",
              file=sys.stderr)
        return 1
    print("Tailscale battery usage set to Unrestricted, so Android won't "
          "stop it.")
    return 0


def _check_dev_options():
    v = _setup_get_setting("global", "development_settings_enabled")
    if v is None:
        return None
    return v == "1"


def _check_wireless_debug():
    v = _setup_get_setting("global", "adb_wifi_enabled")
    if v is None:
        return None
    return v == "1"


def _check_pair():
    return _setup_device_state() == "device"


def _check_install_app():
    out = _setup_sh("pm", "list", "packages", SETUP_APK_PKG)
    if out is None:
        return None
    return "package:{}".format(SETUP_APK_PKG) in out


def _check_self_pair():
    st = _setup_app_status()
    if st is None:
        return None
    return bool(st.get("isPaired"))


def _check_always_on_vpn():
    v = _setup_get_setting("secure", "always_on_vpn_app")
    if v is None:
        return None
    return v == SETUP_VPN_APP


def _check_fix_port():
    if CFG.get("ADB_PORT") != "5555":
        return False
    port = _setup_sh("getprop", "service.adb.tcp.port")
    if port is None:
        return None
    return port == "5555"


def _check_verify():
    return None  # run it to find out


# --- step run functions (agent steps) ---

def _run_prereqs(args):
    ok = True
    r = _setup_spawn([ADB_BIN, "version"], timeout=10)
    if r.returncode != 0:
        print("adb binary missing or broken. Run ./install.sh first.")
        return 1
    print("adb: {}".format((r.stdout or "").strip().splitlines()[0]))
    cfg_path = os.path.join(ROOT, "config.env")
    if not os.path.exists(cfg_path):
        ex = os.path.join(ROOT, "config.env.example")
        if os.path.exists(ex):
            with open(ex) as f:
                content = f.read()
            with open(cfg_path, "w") as f:
                f.write(content)
            print("created config.env from example; fill in PHONE_TAILSCALE_IP.")
        else:
            print("config.env missing and no example found.")
            ok = False
    else:
        print("config.env present.")
    return 0 if ok else 1


def _run_pair(args):
    if not args.code or not args.ip or not args.pair_port:
        print("pair needs --code, --ip and --pair-port from the phone's "
              "pairing dialog (it expires in about a minute).", file=sys.stderr)
        return 1
    code = args.code.strip()
    if not re.fullmatch(r"\d{6}", code):
        print("pair: code must be 6 digits.", file=sys.stderr)
        return 1
    pair_local = 15556
    proxy_host = os.environ.get("HTTPS_PROXY", "")
    socat = None
    if proxy_host:
        # A sandbox reaches the tailnet only through its proxy (tunnel.sh).
        proxy_host = proxy_host.split("://")[-1]
        proxy_auth = proxy_host.split("@")[0] if "@" in proxy_host else ""
        proxy_host = proxy_host.split("@")[-1].split(":")[0]
        socat_cmd = ["socat",
                     "TCP-LISTEN:{},bind=127.0.0.1,reuseaddr".format(pair_local),
                     "PROXY:{}:{}:{},proxyport=3130,proxyauth={}".format(
                         proxy_host, args.ip, args.pair_port, proxy_auth)]
        socat = _setup_popen(socat_cmd)
        time.sleep(1)
        pair_addr = "127.0.0.1:{}".format(pair_local)
    else:  # on the tailnet itself: pair with the phone directly
        pair_addr = "{}:{}".format(args.ip, args.pair_port)
    try:
        r = _setup_spawn([ADB_BIN, "pair", pair_addr],
                         input_text=code + "\n", timeout=30)
        paired = r.returncode == 0
    finally:
        if socat is not None:
            socat.terminate()
    if not paired:
        print("pairing failed. The code probably expired; get a fresh one "
              "from the phone and retry.", file=sys.stderr)
        return 1
    print("paired.")
    connect_port = args.connect_port or CFG.get("ADB_PORT", "5555")
    updates = {"PHONE_TAILSCALE_IP": args.ip, "ADB_PORT": str(connect_port)}
    _setup_write_config(updates)
    print("wrote PHONE_TAILSCALE_IP and ADB_PORT to config.env.")
    _setup_spawn([os.path.join(ROOT, "tunnel.sh"), "start"], timeout=45)
    r = adb("connect", TARGET, timeout=20)
    time.sleep(1)
    if _setup_device_state() == "device":
        print("connected: {}".format(TARGET))
        return 0
    print("paired but connect failed. Output: {}".format(
        ((r.stdout or "") + " " + (r.stderr or "")).strip()[:120]),
        file=sys.stderr)
    return 1


def _setup_find_apk():
    """Locate an adb-auto-enable APK locally or download v0.3.5. Returns path."""
    candidates = []
    for base in (WORKSPACE, os.path.expanduser("~/.cache/burner")):
        try:
            for f in os.listdir(base):
                if f.endswith(".apk") and "adb" in f.lower():
                    candidates.append(os.path.join(base, f))
        except OSError:
            pass
    if candidates:
        return candidates[0]
    api = ("https://api.github.com/repos/mouldybread/adb-auto-enable"
           "/releases/tags/{}".format(SETUP_APK_VERSION))
    try:
        data = json.loads(_setup_urlopen(api).decode("utf-8"))
    except Exception as e:
        print("could not list GitHub releases: {}".format(e), file=sys.stderr)
        return None
    asset_url = None
    for a in data.get("assets", []):
        if a.get("name", "").endswith(".apk"):
            asset_url = a.get("browser_download_url")
            break
    if not asset_url:
        print("no APK asset in release {}.".format(SETUP_APK_VERSION),
              file=sys.stderr)
        return None
    dest = os.path.join(SETUP_APK_CACHE,
                        "adb-auto-enable-{}.apk".format(SETUP_APK_VERSION))
    print("downloading adb-auto-enable {} ...".format(SETUP_APK_VERSION))
    try:
        blob = _setup_urlopen(asset_url, timeout=120)
    except Exception as e:
        print("download failed: {}".format(e), file=sys.stderr)
        return None
    os.makedirs(SETUP_APK_CACHE, exist_ok=True)
    with open(dest, "wb") as f:
        f.write(blob)
    return dest


def _run_install_app(args):
    apk = _setup_find_apk()
    if not apk:
        return 1
    print("installing {} ...".format(os.path.basename(apk)))
    r = adb("install", "-r", apk, timeout=120)
    if r.returncode != 0:
        print("install failed: {}".format(
            ((r.stderr or "") + " " + (r.stdout or "")).strip()[:200]),
            file=sys.stderr)
        return 1
    r = adb("shell", "pm", "grant", SETUP_APK_PKG,
            "android.permission.WRITE_SECURE_SETTINGS", timeout=15)
    if r.returncode != 0:
        print("WRITE_SECURE_SETTINGS grant failed; do it manually on the phone.",
              file=sys.stderr)
        return 1
    r = adb("shell", "dumpsys", "deviceidle", "whitelist",
            "+" + SETUP_APK_PKG, timeout=15)
    if r.returncode != 0:
        print("warning: deviceidle whitelist failed (non-fatal).",
              file=sys.stderr)
    print("installed, granted WRITE_SECURE_SETTINGS, whitelisted.")
    return 0


SETUP_APP_API_PORT = "9093"     # adb-auto-enable's local web API
SETUP_APP_FWD_PORT = "19093"    # where we forward it on this machine


def _setup_app_api(path, body=None, timeout=60):
    """Call adb-auto-enable's local API through adb forward. Dict or None."""
    r = adb("forward", "tcp:" + SETUP_APP_FWD_PORT,
            "tcp:" + SETUP_APP_API_PORT, timeout=15)
    if r.returncode != 0:
        return None
    import urllib.request
    url = "http://127.0.0.1:{}{}".format(SETUP_APP_FWD_PORT, path)
    data = body.encode() if body is not None else None
    req = urllib.request.Request(url, data=data)
    if data is not None:
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        # Error responses carry a JSON body too.
        try:
            return json.loads(e.read().decode("utf-8"))
        except Exception:
            return None


def _setup_app_status():
    return _setup_app_api("/api/status", timeout=15)


def _setup_tap_label(label, scrolls=12):
    """Tap the node labelled exactly `label`, scrolling down to find it."""
    for _ in range(scrolls):
        hits = find_nodes(walk(ui_dump()), label)
        if hits:
            x, y = clickable_target(hits[0])
            tap_center(x, y)
            time.sleep(1.5)
            return True
        w, h = screen_dims()
        adb("shell", "input", "swipe", w // 2, h * 3 // 4, w // 2, h // 4, 300)
        time.sleep(0.8)
    return False


def _setup_read_pair_dialog():
    """Read (code, port) off the open pairing dialog. Never logged or stored."""
    code = port = None
    for n in walk(ui_dump()):
        t = (n["text"] or "").strip()
        if re.fullmatch(r"\d{6}", t):
            code = t
        m = re.fullmatch(r"[0-9a-fA-F.:\[\]]+:(\d{2,5})", t)
        if m:
            port = m.group(1)
    return code, port


def _run_self_pair(args):
    """Do adb-auto-enable's one-time self-pairing for the human, over adb.

    Opens the app once (starts its service and local API), opens Settings >
    Developer options > Wireless debugging > Pair device with pairing code
    on the phone, reads the code and port off the screen, and hands them to
    the app's /api/pair. The app then pairs with the phone over localhost."""
    if _check_self_pair():
        print("ADB Auto Enable is already paired.")
        return 0
    print("the phone will open ADB Auto Enable and Settings by itself for a "
          "few seconds; nothing to tap.")
    adb("shell", "monkey", "-p", SETUP_APK_PKG, "-c",
        "android.intent.category.LAUNCHER", "1", timeout=20)
    time.sleep(3)
    if _setup_app_status() is None:
        # Optional step: burner already works. Don't fail setup over it.
        print("skipped: ADB Auto Enable's built-in pairing page did not come "
              "up on the phone, so it can't be paired. burner still works. "
              "Without it, after the phone restarts the user turns Wireless "
              "debugging back on once and sends a screenshot of that screen. "
              "There's nothing for the user to fix.")
        return 0
    adb("shell", "am", "start", "-a",
        "android.settings.APPLICATION_DEVELOPMENT_SETTINGS", timeout=15)
    time.sleep(2)
    for label in ("Wireless debugging", "Pair device with pairing code"):
        if not _setup_tap_label(label):
            print("could not find '{}' on the phone screen.".format(label),
                  file=sys.stderr)
            return 1
    code, port = _setup_read_pair_dialog()
    if not code or not port:
        print("could not read the pairing code and port off the phone "
              "screen.", file=sys.stderr)
        return 1
    res = _setup_app_api("/api/pair", "port={}&code={}".format(port, code))
    for _ in range(3):
        adb("shell", "input", "keyevent", "KEYCODE_BACK", timeout=10)
        time.sleep(0.5)
    if not res or not res.get("success"):
        print("ADB Auto Enable pairing failed: {}".format(
            (res or {}).get("error", "no response")), file=sys.stderr)
        return 1
    time.sleep(2)
    print("ADB Auto Enable is paired and will keep ADB on after reboots.")
    return 0


def _check_stay_awake():
    v = _setup_get_setting("global", "stay_on_while_plugged_in")
    if v is None:
        return None
    return v == "7"


def _run_stay_awake(args):
    # 7 = stay on while charging from AC, USB or wireless.
    r = adb("shell", "settings", "put", "global", "stay_on_while_plugged_in",
            "7", timeout=15)
    if r.returncode != 0 or not _check_stay_awake():
        print("could not turn on Stay awake while charging.", file=sys.stderr)
        return 1
    print("screen now stays on while the phone is charging.")
    return 0


def _setup_has_secure_lock():
    """True if a PIN, pattern or password is set, None if we can't tell."""
    out = _setup_sh("locksettings", "verify")
    if out is None:
        return None
    return "verified successfully" not in out


def _check_screen_lock():
    secure = _setup_has_secure_lock()
    if secure is None:
        return None
    if secure:
        return False
    return _setup_sh("locksettings", "get-disabled") == "true"


def _run_screen_lock(args):
    secure = _setup_has_secure_lock()
    if secure:
        print("the phone has a PIN, pattern or password, so it locks after a "
              "restart and burner can't get in. Ask the user to remove it "
              "(it needs their PIN, so only they can): Settings > Security & "
              "privacy > Device unlock > Screen lock > enter PIN > None (on "
              "Samsung: Settings > Lock screen > Screen lock type > None). "
              "Then re-run this step.", file=sys.stderr)
        return 1
    r = adb("shell", "locksettings", "set-disabled", "true", timeout=15)
    if r.returncode != 0 or not _check_screen_lock():
        print("could not turn off the swipe lock screen.", file=sys.stderr)
        return 1
    print("lock screen off: the phone opens straight to the home screen.")
    return 0


def _run_always_on_vpn(args):
    lock = _setup_get_setting("secure", "always_on_vpn_lockdown")
    if lock == "1":
        print("always-on VPN lockdown is ON (Block connections without VPN). "
              "Turn it off on the phone first: Settings > Network > VPN > "
              "Tailscale gear > uncheck it. I will not change it for you.",
              file=sys.stderr)
        return 1
    r = adb("shell", "settings", "put", "secure", "always_on_vpn_app",
            SETUP_VPN_APP, timeout=15)
    if r.returncode != 0:
        print("settings put failed.", file=sys.stderr)
        return 1
    v = _setup_get_setting("secure", "always_on_vpn_app")
    if v != SETUP_VPN_APP:
        print("verify failed: always_on_vpn_app is {!r}.".format(v),
              file=sys.stderr)
        return 1
    print("Always-on VPN set to Tailscale (lockdown off). "
          "Tailscale now starts itself after reboot.")
    return 0


def _run_fix_port(args):
    r = adb("shell", "setprop", "service.adb.tcp.port", "5555", timeout=15)
    if r.returncode != 0:
        print("setprop failed.", file=sys.stderr)
        return 1
    _setup_write_config({"ADB_PORT": "5555"})
    _setup_spawn([os.path.join(ROOT, "tunnel.sh"), "start"], timeout=45)
    r = adb("connect", TARGET, timeout=20)
    time.sleep(2)
    port = _setup_sh("getprop", "service.adb.tcp.port")
    if _setup_device_state() == "device" and port == "5555":
        print("adbd is on fixed port 5555. config.env updated.")
        return 0
    print("port switch did not stick (adbd port: {}). The adb-auto-enable "
          "app's self-pairing (step self-pair) is what pins it; make sure "
          "that step is done, then re-run.".format(port), file=sys.stderr)
    return 1


def _run_verify(args):
    rc = cmd_doctor(argparse.Namespace(json=False))
    if rc == 0:
        print("setup GREEN: phone is reachable and healthy.")
    else:
        print("setup RED: doctor found problems (see above).", file=sys.stderr)
    return rc


